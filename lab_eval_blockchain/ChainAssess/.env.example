# EduChain Environment Variables
# Copy this file to .env and fill in your own values

# Alchemy API Key for Sepolia RPC access
# Get your free API key from: https://www.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Pinata API Keys for IPFS file storage
# Get your API keys from: https://www.pinata.cloud/
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here

# Private key for contract deployment (OPTIONAL - only needed if deploying new contracts)
# Use your wallet's private key (NEVER commit this to Git!)
# PRIVATE_KEY=your_private_key_here

# Contract Addresses (Already deployed on Sepolia - no need to change!)
# These are hardcoded in the code as defaults, but you can override them here
VITE_ACCESS_CONTROL_CONTRACT=0xFB7c09E0d25577401cB98C9b29B0465243A97E5F
VITE_BATCH_MANAGEMENT_CONTRACT=0xddD637Fd04a8b14470Bcf3b78c683c1a87C99aB8
VITE_ASSIGNMENT_SUBMISSION_CONTRACT=0xf39A62a69222ad7F51217AFedd46178e7926039d
VITE_TOKEN_REWARD_CONTRACT=0xe319Df69e389fea0F76Ae1546112c2e3e2ED2592

ACCESS_CONTROL_CONTRACT=0xFB7c09E0d25577401cB98C9b29B0465243A97E5F
BATCH_MANAGEMENT_CONTRACT=0xddD637Fd04a8b14470Bcf3b78c683c1a87C99aB8
ASSIGNMENT_SUBMISSION_CONTRACT=0xf39A62a69222ad7F51217AFedd46178e7926039d
TOKEN_REWARD_CONTRACT=0xe319Df69e389fea0F76Ae1546112c2e3e2ED2592

# Vite Pinata Keys (same as above, for client-side)
VITE_PINATA_API_KEY=your_pinata_api_key_here
VITE_PINATA_SECRET_KEY=your_pinata_secret_key_here
